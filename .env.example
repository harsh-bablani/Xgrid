# Local admin CMS — no cloud setup needed for development.
# Run: npm run dev
# Then open: http://localhost:5173/admin

# Example login:
#   Email:    admin@slatebiz.com
#   Password: admin123

# Blog data is stored in: server/data/db.json
# Uploaded images go to:  public/uploads/blogs/
# Sitemap regenerates to: public/sitemap.xml (and GET /sitemap.xml via API)

# Public site URL used for canonical / Open Graph / sitemap absolute links:
VITE_SITE_URL=https://slatebiz.com
# Optional server-side override (sitemap generation):
# SITE_URL=https://slatebiz.com

# Optional — Supabase (for production later):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
