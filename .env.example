# ── Local dev ─────────────────────────────────────────────────────────────
# Run: npm run dev
# Admin: http://localhost:5173/admin
# Login: admin@slatebiz.com / admin123 (or ADMIN_EMAIL / ADMIN_PASSWORD on server)

VITE_SITE_URL=https://slatebiz.com

# Leave empty in dev — Vite proxies /api to localhost:3001
VITE_API_URL=

# ── Render backend (set on Render dashboard) ─────────────────────────────
# NODE_ENV=production
# PORT=10000                                    # Render sets this automatically
# SITE_URL=https://slatebiz.com                 # For sitemap absolute URLs
# API_PUBLIC_URL=https://YOUR-SERVICE.onrender.com
# CORS_ORIGIN=https://slatebiz.com,https://YOUR-FRONTEND.vercel.app
# ADMIN_EMAIL=admin@slatebiz.com
# ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional — Render Persistent Disk (recommended for production)
# Mount disk at /var/data, then:
# DATA_DIR=/var/data
# UPLOAD_DIR=/var/data/uploads/blogs

# ── Frontend production build (Vercel / Netlify / etc.) ───────────────────
# VITE_SITE_URL=https://slatebiz.com
# VITE_API_URL=https://YOUR-SERVICE.onrender.com

# Optional — Supabase (future):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
