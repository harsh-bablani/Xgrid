{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.(webp|png|jpg|jpeg|svg|ico|mp4)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/jewelbiz(/.*)?",
      "has": [{ "type": "host", "value": "(www\\.)?slatebiz\\.(com|in)" }],
      "destination": "https://www.jewelbiz.in/",
      "permanent": true
    },
    {
      "source": "/curabiz(/.*)?",
      "has": [{ "type": "host", "value": "(www\\.)?slatebiz\\.(com|in)" }],
      "destination": "https://www.curabiz.in/",
      "permanent": true
    },
    {
      "source": "/jewelbiz(/.*)?",
      "has": [{ "type": "host", "value": "(www\\.)?jewelbiz\\.in" }],
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/curabiz(/.*)?",
      "has": [{ "type": "host", "value": "(www\\.)?curabiz\\.in" }],
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|api/).*)",
      "destination": "/index.html"
    }
  ]
}
